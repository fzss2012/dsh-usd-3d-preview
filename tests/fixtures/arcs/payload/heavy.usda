#usda 1.0
(
    defaultPrim = "Heavy"
)

def Xform "Heavy"
{
    def Mesh "block"
    {
        uniform bool doubleSided = 1
        int[] faceVertexCounts = [3, 3]
        int[] faceVertexIndices = [0, 1, 2, 0, 2, 3]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (1, 0, 1), (0, 0, 1)]
        uniform token subdivisionScheme = "none"
    }
}
