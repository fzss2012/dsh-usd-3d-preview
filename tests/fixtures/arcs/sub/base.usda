#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "base"
{
    def Mesh "floor"
    {
        uniform bool doubleSided = 1
        int[] faceVertexCounts = [3, 3]
        int[] faceVertexIndices = [0, 1, 2, 0, 2, 3]
        point3f[] points = [(0, 0, 0), (2, 0, 0), (2, 0, 2), (0, 0, 2)]
        uniform token subdivisionScheme = "none"
    }
}
