#usda 1.0
(
    defaultPrim = "Drawer"
    metersPerUnit = 1
    upAxis = "Y"
)

# A sliding drawer: one prismatic joint along X with linear limits 0..0.4 stage
# units. The tray body sits at (0.05, 0.2, 0) and the joint frame is authored on
# both sides, so frame coincidence can be asserted after motion.

def Xform "Drawer"
{
    def Xform "Bodies"
    {
        def Xform "carcass"
        (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            float physics:mass = 8
            def Mesh "shell"
            {
                int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
                int[] faceVertexIndices = [1, 2, 3, 0, 7, 6, 5, 4, 4, 5, 1, 0, 2, 6, 7, 3, 3, 7, 4, 0, 5, 6, 2, 1]
                point3f[] points = [(-0.4, 0, -0.3), (0.6, 0, -0.3), (0.6, 0, 0.3), (-0.4, 0, 0.3), (-0.4, 0.4, -0.3), (0.6, 0.4, -0.3), (0.6, 0.4, 0.3), (-0.4, 0.4, 0.3)]
            }
        }

        def Xform "tray"
        (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            double3 xformOp:translate = (0.05, 0.2, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            float physics:mass = 2
            def Mesh "front"
            {
                int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
                int[] faceVertexIndices = [1, 2, 3, 0, 7, 6, 5, 4, 4, 5, 1, 0, 2, 6, 7, 3, 3, 7, 4, 0, 5, 6, 2, 1]
                point3f[] points = [(0, -0.15, -0.25), (0.02, -0.15, -0.25), (0.02, -0.15, 0.25), (0, -0.15, 0.25), (0, 0.15, -0.25), (0.02, 0.15, -0.25), (0.02, 0.15, 0.25), (0, 0.15, 0.25)]
            }
        }
    }

    def PhysicsPrismaticJoint "slide"
    {
        uniform token physics:axis = "X"
        float physics:lowerLimit = 0
        float physics:upperLimit = 0.4
        point3f physics:localPos0 = (0.05, 0.2, 0)
        quatf physics:localRot0 = (1, 0, 0, 0)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
        rel physics:body0 = </Drawer/Bodies/carcass>
        rel physics:body1 = </Drawer/Bodies/tray>
    }

}
