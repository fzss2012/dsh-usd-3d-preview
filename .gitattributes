# Keep the repository at LF on every platform; the working tree follows.
* text=auto eol=lf

# USD containers may be binary — never transcode them.
*.usd binary
*.usdc binary
*.usdz binary
*.png binary

# An IFCZIP is a zip package; an .ifc is a STEP text file and stays text so a
# diff of a hand-authored fixture is readable.
*.ifczip binary
